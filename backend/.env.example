PORT=8080
# Cadena de conexión de Supabase (PostgreSQL)
# Formato: postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# o conexión directa: postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:TU_PASSWORD_AQUI@db.TU_PROJECT_REF.supabase.co:5432/postgres

# API Key opcional de Google Gemini para IA generativa avanzada
GEMINI_API_KEY=
